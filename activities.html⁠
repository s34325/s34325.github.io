<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>กิจกรรมและเกียรติบัตร 🏆✨</title>

<!-- นำเข้าฟอนต์น่ารัก Mali จาก Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Mali:wght@400;600;700&display=swap" rel="stylesheet">

<style>
* {
    box-sizing: border-box;
}

body {
    font-family: 'Mali', cursive, sans-serif;
    background: linear-gradient(135deg, #FFE5EC 0%, #FFC2D1 100%);
    color: #5A4B41;
    text-align: center;
    padding: 40px 20px;
    margin: 0;
    min-height: 100vh;
}

.container {
    max-width: 800px;
    margin: 0 auto;
}

/* ส่วนหัวข้อหลัก */
.title-header {
    background-color: rgba(255, 255, 255, 0.6);
    padding: 15px 25px;
    border-radius: 25px;
    display: inline-block;
    backdrop-filter: blur(5px);
    margin-bottom: 20px;
}

h1 {
    margin: 0;
    color: #FF70A6;
    font-size: 2rem;
    text-shadow: 1px 1px 0px #fff;
}

.subtitle {
    color: #8C7A6B;
    font-size: 1rem;
    margin-bottom: 30px;
}

/* การ์ดหมวดหมู่ */
.category-card {
    background: #FFFFFF;
    padding: 25px;
    margin-bottom: 35px;
    border-radius: 20px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
    border: 2px solid #FFF0F5;
    text-align: left;
}

.category-title {
    color: #FF70A6;
    font-size: 1.35rem;
    margin-top: 0;
    margin-bottom: 20px;
    border-bottom: 2px dashed #FFC2D1;
    padding-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
}

/* ตาราง / กริดแสดงผลเกียรติบัตร */
.cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}

/* การ์ดเกียรติบัตรแต่ละใบ */
.cert-item {
    background: #FFF0F5;
    border-radius: 15px;
    padding: 15px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid #FFE5EC;
}

.cert-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 15px rgba(255, 112, 166, 0.2);
    border-color: #FFB3C6;
}

.cert-img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 10px;
    border: 3px solid #FFFFFF;
    box-shadow: 0 4px 8px rgba(0,0,0,0.05);
    background-color: #EFEFEF;
}

.cert-caption {
    font-size: 0.95rem;
    color: #6C5C53;
    margin-top: 12px;
    margin-bottom: 5px;
    font-weight: 600;
}

.cert-date {
    font-size: 0.8rem;
    color: #A08C7D;
}

/* ปุ่มกดน่ารักๆ */
.btn {
    display: inline-block;
    background: #FF70A6;
    color: white;
    padding: 12px 30px;
    text-decoration: none;
    border-radius: 25px;
    margin-top: 10px;
    font-weight: 600;
    box-shadow: 0 5px 15px rgba(255, 112, 166, 0.4);
    transition: all 0.3s ease;
}

.btn:hover {
    background: #FF477E;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 71, 126, 0.4);
}
</style>

</head>
<body>

<div class="container">

    <!-- ส่วนหัวข้อ -->
    <div class="title-header">
        <h1>🏆 กิจกรรมและเกียรติบัตร 📜</h1>
    </div>
    <p class="subtitle">รวบรวมความภาคภูมิใจ ผลงานการอบรม จิตอาสา และการแข่งขัน ✨</p>

    <!-- หมวดที่ 1: เกียรติบัตรการอบรม -->
    <div class="category-card">
        <h2 class="category-title">📚 1. เกียรติบัตรการอบรม / สัมมนา</h2>
        <div class="cert-grid">
            
            <!-- รูปที่ 1 -->
            <div class="cert-item">
                <!-- เปลี่ยนชื่อไฟล์รูปภาพใน src="..." ได้เลยค่ะ -->
                <img src="cert-training1.jpg" alt="เกียรติบัตรการอบรม 1" class="cert-img">
                <div class="cert-caption">โครงการอบรมความรู้ Medical Technology</div>
                <div class="cert-date">สิงหาคม 2026</div>
            </div>

            <!-- รูปที่ 2 -->
            <div class="cert-item">
                <img src="cert-training2.jpg" alt="เกียรติบัตรการอบรม 2" class="cert-img">
                <div class="cert-caption">สัมมนาเชิงปฏิบัติการวิศวกรรมชีวเวช</div>
                <div class="cert-date">พฤษภาคม 2026</div>
            </div>

        </div>
    </div>

    <!-- หมวดที่ 2: เกียรติบัตรจิตอาสา -->
    <div class="category-card">
        <h2 class="category-title">💖 2. เกียรติบัตรจิตอาสา / ทำประโยชน์เพื่อสังคม</h2>
        <div class="cert-grid">
            
            <!-- รูปที่ 1 -->
            <div class="cert-item">
                <img src="cert-volunteer1.jpg" alt="เกียรติบัตรจิตอาสา 1" class="cert-img">
                <div class="cert-caption">กิจกรรมจิตอาสาบริการสุขภาพชุมชน</div>
                <div class="cert-date">กรกฎาคม 2026</div>
            </div>

            <!-- รูปที่ 2 -->
            <div class="cert-item">
                <img src="cert-volunteer2.jpg" alt="เกียรติบัตรจิตอาสา 2" class="cert-img">
                <div class="cert-caption">จิตอาสาช่วยเหลืองานโรงพยาบาล</div>
                <div class="cert-date">มกราคม 2026</div>
            </div>

        </div>
    </div>

    <!-- หมวดที่ 3: เกียรติบัตรการแข่งขัน -->
    <div class="category-card">
        <h2 class="category-title">🥇 3. เกียรติบัตรการแข่งขัน / รางวัล</h2>
        <div class="cert-grid">
            
            <!-- รูปที่ 1 -->
            <div class="cert-item">
                <img src="cert-contest1.jpg" alt="เกียรติบัตรการแข่งขัน 1" class="cert-img">
                <div class="cert-caption">รางวัลเหรียญทอง การประกวดโครงงานวิทยาศาสตร์</div>
                <div class="cert-date">มิถุนายน 2026</div>
            </div>

            <!-- รูปที่ 2 -->
            <div class="cert-item">
                <img src="cert-contest2.jpg" alt="เกียรติบัตรการแข่งขัน 2" class="cert-img">
                <div class="cert-caption">การแข่งขันตอบปัญหาทักษะทางวิชาการ</div>
                <div class="cert-date">กุมภาพันธ์ 2026</div>
            </div>

        </div>
    </div>

    <!-- ปุ่มกลับหน้าหลัก -->
    <a href="index.html" class="btn">🏠 กลับหน้าหลัก</a>

</div>

</body>
</html>
