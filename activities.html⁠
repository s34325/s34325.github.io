<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>กิจกรรมและเกียรติบัตร ✨</title>

<!-- นำเข้าฟอนต์ Mali จาก Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Mali:wght@400;600;700&display=swap" rel="stylesheet">

<style>
* {
    box-sizing: border-box;
}

body {
    font-family: 'Mali', cursive, sans-serif;
    background: linear-gradient(135deg, #FFE5EC 0%, #FFC2D1 100%);
    color: #5A4B41;
    text-align: center;
    padding: 40px 20px;
    margin: 0;
    min-height: 100vh;
}

.container {
    max-width: 850px;
    margin: 0 auto;
}

/* ส่วนหัวข้อหลัก */
.title-header {
    background-color: rgba(255, 255, 255, 0.75);
    padding: 15px 30px;
    border-radius: 25px;
    display: inline-block;
    backdrop-filter: blur(5px);
    margin-bottom: 25px;
    box-shadow: 0 4px 15px rgba(255, 112, 166, 0.2);
}

h1 {
    margin: 0;
    color: #FF70A6;
    font-size: 1.8rem;
    text-shadow: 1px 1px 0px #fff;
}

.subtitle {
    color: #8C7A6B;
    font-size: 0.95rem;
    margin-top: 5px;
    margin-bottom: 0;
}

/* ตารางแสดงการ์ดกิจกรรม (Grid Layout) */
.activity-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 25px;
    margin-top: 20px;
}

/* การ์ดกิจกรรม/เกียรติบัตร */
.activity-card {
    background: #FFFFFF;
    border-radius: 22px;
    padding: 22px;
    box-shadow: 0 8px 20px rgba(255, 112, 166, 0.15);
    border: 2px solid #FFF0F5;
    text-align: left;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
}

.activity-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 25px rgba(255, 112, 166, 0.25);
}

/* กรอบรูปภาพเกียรติบัตร */
.img-container {
    width: 100%;
    height: 220px;
    border-radius: 15px;
    overflow: hidden;
    background-color: #FFF0F5;
    margin-bottom: 15px;
    border: 1px solid #FFE5EC;
    position: relative;
}

.img-container img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* ปรับรูปให้อยู่ในกรอบอย่างสวยงาม */
    transition: transform 0.3s ease;
}

.activity-card:hover .img-container img {
    transform: scale(1.03);
}

.tag {
    display: inline-block;
    background-color: #FFE5EC;
    color: #FF477E;
    font-size: 0.8rem;
    padding: 4px 12px;
    border-radius: 12px;
    font-weight: 600;
    margin-bottom: 10px;
}

.date-text {
    font-size: 0.8rem;
    color: #A0938A;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 5px;
}

.activity-card h3 {
    margin: 0 0 10px 0;
    color: #6B4C3B;
    font-size: 1.2rem;
    line-height: 1.4;
}

/* ส่วนข้อความอธิบายเกียรติบัตร */
.description {
    margin: 0 0 15px 0;
    color: #6C5C53;
    font-size: 0.92rem;
    line-height: 1.7;
    flex-grow: 1; /* ช่วยให้การ์ดสูงเท่ากันสวยงาม */
}

/* ป้ายทักษะที่ได้รับ */
.skills-gained {
    border-top: 1px dashed #FFE5EC;
    padding-top: 10px;
    margin-top: auto;
}

.skills-gained span {
    font-size: 0.8rem;
    background: #F0F4FF;
    color: #4A69E2;
    padding: 3px 8px;
    border-radius: 8px;
    margin-right: 5px;
    display: inline-block;
}

/* ปุ่มย้อนกลับ */
.btn-back {
    display: inline-block;
    background: #FF70A6;
    color: white;
    padding: 12px 30px;
    text-decoration: none;
    border-radius: 25px;
    margin-top: 35px;
    font-weight: 600;
    box-shadow: 0 5px 15px rgba(255, 112, 166, 0.4);
    transition: all 0.3s ease;
}

.btn-back:hover {
    background: #FF477E;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 71, 126, 0.4);
}
</style>

</head>
<body>

<div class="container">

    <!-- หัวข้อหน้า -->
    <div class="title-header">
        <h1>🏆 กิจกรรมและเกียรติบัตร</h1>
        <p class="subtitle">รวบรวมความภาคภูมิใจและผลงานการเรียนรู้ของฉัน 💕</p>
    </div>

    <!-- รายการเกียรติบัตรและกิจกรรม -->
    <div class="activity-grid">

        <!-- ใบที่ 1: เกียรติบัตรการเข้าร่วมอบรบ -->
        <div class="activity-card">
            <div class="img-container">
                <!-- เปลี่ยนชื่อไฟล์รูปภาพของคุณตรง src="..." -->
                <img src="certificate1.jpg" alt="เกียรติบัตรการอบรม">
            </div>
            <div>
                <span class="tag">📜 เกียรติบัตร</span>
                <div class="date-text">📅 มกราคม 2026 | โดย มหาวิทยาลัย/หน่วยงาน</div>
            </div>
            <h3>เกียรติบัตรการอบรมเชิงปฏิบัติการคอมพิวเตอร์</h3>
            <p class="description">
                ผ่านการอบรมเชิงปฏิบัติการพัฒนาทักษะดิจิทัลและการเขียนโปรแกรมเบื้องต้น ได้เรียนรู้เกี่ยวกับพื้นฐาน HTML, CSS และเทคนิคการสร้างเว็บไซต์ใช้งานจริง
            </p>
            <div class="skills-gained">
                <span>#HTML/CSS</span>
                <span>#WebDevelopment</span>
            </div>
        </div>

        <!-- ใบที่ 2: เกียรติบัตรกิจกรรมแข่งขัน -->
        <div class="activity-card">
            <div class="img-container">
                <!-- เปลี่ยนชื่อไฟล์รูปภาพของคุณตรง src="..." -->
                <img src="certificate2.jpg" alt="เกียรติบัตรรางวัล">
            </div>
            <div>
                <span class="tag">🥇 รางวัลและการแข่งขัน</span>
                <div class="date-text">📅 ธันวาคม 2025 | โดย โรงเรียน...</div>
            </div>
            <h3>รางวัลเข้าร่วมการแข่งขันตอบปัญหาวิทยาศาสตร์</h3>
            <p class="description">
                ได้รับการคัดเลือกเป็นตัวแทนเข้าร่วมการแข่งขันทักษะวิชาการด้านวิทยาศาสตร์คำนวณ ได้ฝึกกระบวนการคิดวิเคราะห์ และการแก้ไขปัญหาเฉพาะหน้า
            </p>
            <div class="skills-gained">
                <span>#ProblemSolving</span>
                <span>#Science</span>
            </div>
        </div>

        <!-- ใบที่ 3: กิจกรรมจิตอาสา หรือกิจกรรมโรงเรียน -->
        <div class="activity-card">
            <div class="img-container">
                <!-- เปลี่ยนชื่อไฟล์รูปภาพของคุณตรง src="..." -->
                <img src="activity1.jpg" alt="ภาพกิจกรรม">
            </div>
            <div>
                <span class="tag">🌸 กิจกรรมจิตอาสา</span>
                <div class="date-text">📅 พฤศจิกายน 2025 | โรงเรียน...</div>
            </div>
            <h3>กิจกรรมจิตอาสาพัฒนาโรงเรียนและชุมชน</h3>
            <p class="description">
                เข้าร่วมกิจกรรมช่วยงานวิชาการของโรงเรียน จัดบอร์ดนิทรรศการ และร่วมทำประโยชน์เพื่อส่วนรวม ฝึกการทำงานร่วมกับผู้อื่นและความรับผิดชอบ
            </p>
            <div class="skills-gained">
                <span>#Teamwork</span>
                <span>#Leadership</span>
            </div>
        </div>

    </div>

    <!-- ปุ่มกลับไปหน้า Portfolio -->
    <a href="portfolio.html" class="btn-back">⬅️ กลับหน้าแฟ้มสะสมงาน</a>

</div>

</body>
</html>
